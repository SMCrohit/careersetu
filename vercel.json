{
  "functions": {
    "api/index.py": {
      "includeFiles": "backend/**",
      "excludeFiles": "{android/**,ios/**,build/**,lib/**,.dart_tool/**,admin-frontend/**,assets/**,test/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
